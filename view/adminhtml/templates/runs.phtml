<?php
/**
 * @var \Modracx\FrontendDevTools\Block\Adminhtml\Runs $block
 * @var \Magento\Framework\Escaper $escaper
 */

$runs = $block->getRuns();
?>
<div class="admin__data-grid-outer-wrap">
    <p class="admin__field-note" style="margin-bottom:12px">
        <?= $escaper->escapeHtml(__(
            'Storefront requests profiled by Modracx Frontend Dev Tools, newest first. Open a '
            . 'run in the storefront toolbar\'s History tab to see its panels — this list is '
            . 'for seeing what the storefront has been doing without browsing it.'
        )) ?>
    </p>

    <?php if (!$runs): ?>
        <div class="message message-notice">
            <?= $escaper->escapeHtml(__(
                'No runs stored. Either nothing has been profiled yet, or profile storage is '
                . 'switched off under Stores > Configuration > Advanced > Modracx Frontend Dev Tools.'
            )) ?>
        </div>
    <?php else: ?>
        <table class="data-grid">
            <thead>
            <tr>
                <th class="data-grid-th"><?= $escaper->escapeHtml(__('When')) ?></th>
                <th class="data-grid-th"><?= $escaper->escapeHtml(__('Action')) ?></th>
                <th class="data-grid-th"><?= $escaper->escapeHtml(__('URL')) ?></th>
                <th class="data-grid-th"><?= $escaper->escapeHtml(__('FPC')) ?></th>
                <th class="data-grid-th"><?= $escaper->escapeHtml(__('Time')) ?></th>
                <th class="data-grid-th"><?= $escaper->escapeHtml(__('SQL')) ?></th>
                <th class="data-grid-th"><?= $escaper->escapeHtml(__('Blocks')) ?></th>
                <th class="data-grid-th"><?= $escaper->escapeHtml(__('Findings')) ?></th>
                <th class="data-grid-th"><?= $escaper->escapeHtml(__('From')) ?></th>
            </tr>
            </thead>
            <tbody>
            <?php foreach ($runs as $run): ?>
                <tr class="data-row">
                    <td><?= $escaper->escapeHtml((string)$run['created_at']) ?></td>
                    <td>
                        <?= $escaper->escapeHtml((string)$run['method']) ?>
                        <strong><?= $escaper->escapeHtml((string)$run['full_action']) ?></strong>
                        <?php if (!empty($run['is_ajax'])): ?>
                            <span>· ajax</span>
                        <?php endif; ?>
                    </td>
                    <td style="max-width:340px;overflow:hidden;text-overflow:ellipsis">
                        <?= $escaper->escapeHtml((string)$run['url']) ?>
                    </td>
                    <td><?= $escaper->escapeHtml((string)$run['fpc_status']) ?></td>
                    <td><?= $escaper->escapeHtml($block->ms($run['duration_ms'])) ?></td>
                    <td><?= (int)$run['query_count'] ?></td>
                    <td><?= (int)$run['block_count'] ?></td>
                    <td><?= (int)$run['issue_count'] ?>
                        <?php if (!empty($run['max_severity'])): ?>
                            (<?= $escaper->escapeHtml((string)$run['max_severity']) ?>)
                        <?php endif; ?>
                    </td>
                    <td><?= $escaper->escapeHtml((string)$run['client_ip']) ?></td>
                </tr>
            <?php endforeach; ?>
            </tbody>
        </table>
    <?php endif; ?>
</div>
