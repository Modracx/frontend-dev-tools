<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="modracxFrontendToken" xsi:type="object">Modracx\FrontendDevTools\Console\Command\TokenCommand</item>
            </argument>
        </arguments>
    </type>

    <!--
        These two are declared globally rather than in etc/frontend/di.xml on purpose.

        Both wrap objects that are built during bootstrap: the application itself, and the
        database logger that the very first configuration read goes through. Area
        configuration is not loaded until launch() is already running, so an area-scoped
        plugin on either of them would never be generated. Each checks the area itself and
        does nothing anywhere but the storefront.
    -->
    <type name="Magento\Framework\App\Response\Http">
        <plugin name="modracx_fdt_toolbar_injector"
                type="Modracx\FrontendDevTools\Plugin\App\ToolbarInjector"
                sortOrder="1000"/>
    </type>

    <type name="Magento\Framework\DB\LoggerInterface">
        <plugin name="modracx_fdt_query_logger"
                type="Modracx\FrontendDevTools\Plugin\Db\QueryLogger"
                sortOrder="10"/>
    </type>
</config>
